; Credentials for the certbot DNS-01 plugin selected by ACME_DNS_PLUGIN.
;
; Copy to secrets/dns.ini and `chmod 600` it. certbot refuses to use a
; credentials file that is group- or world-readable.
;
; Cloudflare (ACME_DNS_PLUGIN=cloudflare) - a scoped API token, not the global
; API key. Permissions: Zone / DNS / Edit, restricted to the single zone.
dns_cloudflare_api_token = 0123456789abcdef0123456789abcdef01234567

; DigitalOcean (ACME_DNS_PLUGIN=digitalocean):
; dns_digitalocean_token = 0123456789abcdef

; Route53 (ACME_DNS_PLUGIN=route53) takes no credentials file. Delete
; secrets/dns.ini entirely and put AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY /
; AWS_REGION in .env instead; the entrypoint skips the credentials flag when
; the file is absent.
